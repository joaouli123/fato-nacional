NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexo
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Administrative schema/bootstrap credential; also an ingestion alias during migration.
INIT_SCHEMA_TOKEN=replace-with-a-long-random-token
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=glm-5.2
# Chave oficial necessária para o modelo de pesquisa com busca web.
CHATGPT_API_KEY=
AI_PROVIDER=opencode-go
AI_MODEL_TRIAGE=deepseek-v4-flash
AI_MODEL_RESEARCH=gpt-5-search-api
AI_MODEL_WRITING=glm-5.2
AI_MODEL_EDITING=deepseek-v4-pro
AI_MODEL_FACTCHECK=deepseek-v4-pro
AI_MODEL_SEO=deepseek-v4-flash
AI_MODEL_IMAGE=glm-5.1
AI_MODEL_AUDIT=deepseek-v4-pro
PORTAL_INTERNAL_URL=http://localhost:3000
AGENT_QUEUE_NAME=editorial-agents
SCHEDULE_TIMEZONE=America/Sao_Paulo
WORKER_CONCURRENCY=2
# Canonical credential shared by the portal, BullMQ worker and schedulers.
AUTOMATION_TOKEN=replace-with-a-long-random-automation-token
# Compatibility only: old cron deployments may still provide CRON_TOKEN.
# CRON_TOKEN=
# IMAGE_GEN_TOKEN remains an admin media credential and a legacy publication
# automation alias. New automation services should use AUTOMATION_TOKEN.
IMAGE_GEN_TOKEN=replace-with-a-long-random-token
PEXELS_API_KEY=
PIXABAY_API_KEY=
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
